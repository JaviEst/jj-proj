# Full-stack image: build frontend app, serve API + static UI from FastAPI.

FROM node:20-alpine AS frontend-build
WORKDIR /frontend

COPY code/frontend/frontend/package*.json ./
RUN npm ci

COPY code/frontend/frontend/ ./
RUN npm run build

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY code/backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY code/backend/pyproject.toml ./pyproject.toml
COPY code/backend/src ./src
RUN pip install --no-cache-dir .

# Copy frontend build output into FastAPI static directory.
COPY --from=frontend-build /frontend/dist /app/static

EXPOSE 8000

CMD ["uvicorn", "asset_ltv.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
